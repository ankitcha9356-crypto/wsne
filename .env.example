# Copy of this file with real secrets is created for you by: ./wsne setup
# ---------------------------------------------------------------- general
COMPANY_NAME="WSNE Consulting"
# Address candidates use to open the assessment (your Mac's Wi-Fi address, or your domain later)
PUBLIC_URL=http://localhost:8000
ADMIN_USER=admin
ADMIN_PASSWORD=__GENERATED__

# ---------------------------------------------------------------- hub
# tiny.en is faster, small.en is more accurate
WHISPER_MODEL=base.en
# Role used for emails with no role code in the subject
DEFAULT_ROLE=INTL-VOICE
# Fallback interview booking link, e.g. http://localhost:3000/your-name/interview
INTERVIEW_LINK=

# Optional: send emails from the hub (leave blank to use WhatsApp/copy-paste only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: read new applications from a mailbox
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Optional: "Add to Chatwoot" button (create the token in Chatwoot > Profile settings)
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=1

# ---------------------------------------------------------------- databases and secrets
POSTGRES_PASSWORD=__GENERATED__
REDIS_PASSWORD=__GENERATED__
CHATWOOT_SECRET_KEY_BASE=__GENERATED__
CALCOM_NEXTAUTH_SECRET=__GENERATED__
CALCOM_ENCRYPTION_KEY=__GENERATED__
OPENCATS_DB_PASSWORD=__GENERATED__
OPENCATS_DB_ROOT_PASSWORD=__GENERATED__

# ---------------------------------------------------------------- image versions
CHATWOOT_TAG=latest
CALCOM_TAG=latest
METABASE_TAG=latest
# Apple Silicon Macs: tools that publish Intel-only images run through emulation.
CALCOM_PLATFORM=linux/amd64
METABASE_PLATFORM=linux/amd64
